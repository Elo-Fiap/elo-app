# Copie para .env (o .env fica fora do repositório). Variáveis EXPO_PUBLIC_* ficam
# visíveis no app: nunca coloque segredo aqui. Reinicie o Expo depois de mudar.

# true: INMET, Open-Meteo e a API do bairro usam dados de exemplo. A tela "Trocar área" continua
# usando a internet (CEP e distritos).
EXPO_PUBLIC_USE_MOCK=true

# Endereço da API do bairro (C#), sem barra no final. Vazio: usa os dados de exemplo.
# Exemplo: https://elo-da-chuva.exemplo.com.br/api
EXPO_PUBLIC_API_URL=
